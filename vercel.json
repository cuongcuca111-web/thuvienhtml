{
  "version": 2,
  "rewrites": [
    { "source": "/api/billing/:action", "destination": "/api/billing?action=:action" },
    { "source": "/api/admin/billing/:action", "destination": "/api/admin/billing?action=:action" },
    { "source": "/api/admin/ai/:action", "destination": "/api/admin/ai?action=:action" },
    { "source": "/api/admin/plans/:action", "destination": "/api/admin/plans?action=:action" },
    { "source": "/api/admin/pricing/:action", "destination": "/api/admin/plans?action=pricing-:action" },
    { "source": "/api/admin/codes/:action", "destination": "/api/admin/codes?action=:action" },
    { "source": "/api/admin/prompts/:action", "destination": "/api/admin/prompts?action=:action" },
    { "source": "/api/admin/prompts", "destination": "/api/admin/prompts" },
    { "source": "/api/prompts", "destination": "/api/prompts" },
    { "source": "/api/admin/users/:action", "destination": "/api/admin/users?action=:action" }
  ]
}
