rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Cấu hình hệ thống & hạn mức các gói:
    // Cấu hình giao diện và hiệu ứng lễ hội:
    // Đọc công khai để mọi người dùng tải giao diện; chỉ Admin mới có quyền ghi.
    match /config/theme_settings {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Mọi người dùng (kể cả Khách vãng lai) được ĐỌC công khai để hiển thị tính năng và hạn mức.
    // TUYỆT ĐỐI CẤM GHI từ client - Mọi chỉnh sửa chỉ thực hiện qua Firebase Admin SDK trên Server.
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Khóa API Bí mật & Bộ nhớ đệm (admin_secrets, payment_config, ai_cache, users_guest_usage):
    // TUYỆT ĐỐI CẤM ĐỌC & CẤM GHI từ phía Client!
    // Chỉ có mã nguồn chạy trên máy chủ (Firebase Admin SDK) mới có quyền truy cập.
    match /admin_secrets/{document=**} {
      allow read, write: if false;
    }
    match /payment_config/{document=**} {
      allow read, write: if false;
    }
    match /ai_cache/{document=**} {
      allow read, write: if false;
    }
    match /users_guest_usage/{document=**} {
      allow read, write: if false;
    }

    // 3. Giám sát Chi phí AI & Thống kê sử dụng (AI Usage):
    match /ai_usage/{document=**} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // 4. Nhật ký quản trị (Audit Log):
    match /admin_audit/{document=**} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // 5. Mã kích hoạt gói:
    match /activation_codes/{code} {
      allow read, write: if false;
    }

    // 6. Liên kết chia sẻ bài học công khai (Public Shares):
    match /artifacts/{appId}/public_shares/{shareId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/artifacts/$(appId)/public_shares/$(shareId)).data.authorId == request.auth.uid;
      }
    }

    // 7. Đơn hàng Nâng cấp gói (Billing Orders):
    // Người dùng chỉ được ĐỌC đơn hàng do chính mình tạo (resource.data.uid == request.auth.uid).
    // TUYỆT ĐỐI CẤM GHI từ client - Đơn hàng do Server tạo và cập nhật trạng thái.
    match /billing_orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 8. Đơn chưa khớp & Nhật ký Webhook: Cấm toàn bộ client
    match /billing_unmatched/{document=**} {
      allow read, write: if false;
    }
    match /billing_webhook_logs/{document=**} {
      allow read, write: if false;
    }

    // 9. Dữ liệu cá nhân của người dùng:
    // CẤM client tự ý ghi vào nhánh billing/.* (chỉ Server qua Admin SDK mới được ghi billing/plan)
    match /artifacts/{appId}/users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /billing/{billingDoc=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /{subcollection}/{docPath=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && subcollection != 'billing';
      }
    }

    // Mặc định từ chối tất cả các collection khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
